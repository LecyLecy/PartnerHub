DATABASE_URL=
DIRECT_URL=
MANAGEMENT_SECRET_PEPPER=
QR_SECRET_PEPPER=

# Build-time flag. Set to 1 only for a demo build with fictional in-browser data and demo accounts.
# Leave empty (or 0) for every real deployment. next.config.ts pins the default to 0, and a build without
# the variable emits no demo chunks (verified by searching .next/static).
NEXT_PUBLIC_PARTNERHUB_DEMO=
